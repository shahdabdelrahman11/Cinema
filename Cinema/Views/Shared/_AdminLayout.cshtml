
@{
    var ctrl = ViewContext.RouteData.Values["controller"]?.ToString();
    var area = ViewContext.RouteData.Values["area"]?.ToString();

    string Active(string c) =>
        ctrl == c && area == "Admin" ? "active" : "";
}

<!DOCTYPE html>
<html lang="en-US" dir="ltr">
<head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewData["Title"] - Cinema Admin</title>

    <script src="~/falcon/assets/js/config.js"></script>
    <script src="~/falcon/vendors/simplebar/simplebar.min.js"></script>

    <link rel="preconnect" href="https://fonts.gstatic.com">
    <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,500,600,700%7cPoppins:300,400,500,600,700,800,900&amp;display=swap" rel="stylesheet">
    <link href="~/falcon/vendors/simplebar/simplebar.min.css" rel="stylesheet">
    <link href="~/falcon/assets/css/theme-rtl.min.css" rel="stylesheet" id="style-rtl">
    <link href="~/falcon/assets/css/theme.min.css" rel="stylesheet" id="style-default">
    <link href="~/falcon/assets/css/user-rtl.min.css" rel="stylesheet" id="user-style-rtl">
    <link href="~/falcon/assets/css/user.min.css" rel="stylesheet" id="user-style-default">

    <script>
        var isRTL = JSON.parse(localStorage.getItem('isRTL'));

        if (isRTL) {
            document.getElementById('style-default').setAttribute('disabled', true);
            document.getElementById('user-style-default').setAttribute('disabled', true);
            document.querySelector('html').setAttribute('dir', 'rtl');
        } else {
            document.getElementById('style-rtl').setAttribute('disabled', true);
            document.getElementById('user-style-rtl').setAttribute('disabled', true);
        }
    </script>
</head>

<body>
    <main class="main" id="top">
        <div class="container" data-layout="container">

            <!-- Sidebar -->
            <nav class="navbar navbar-light navbar-vertical navbar-expand-xl">

                <div class="d-flex align-items-center">
                    <div class="toggle-icon-wrapper">
                        <button class="btn navbar-toggler-humburger-icon navbar-vertical-toggle"
                                data-bs-toggle="tooltip"
                                data-bs-placement="left"
                                title="Toggle Navigation">
                            <span class="navbar-toggle-icon">
                                <span class="toggle-line"></span>
                            </span>
                        </button>
                    </div>

                    <a class="navbar-brand"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <div class="d-flex align-items-center py-3">
                            <img class="me-2" src="~/images/cinema-logo.svg" alt="" width="40" />
                            <span class="font-sans-serif">Cinema</span>
                        </div>
                    </a>
                </div>

                <div class="collapse navbar-collapse" id="navbarVerticalCollapse">
                    <div class="navbar-vertical-content scrollbar">

                        <ul class="navbar-nav flex-column mb-3" id="navbarVerticalNav">

                            <li class="nav-item">

                                <!-- Dashboard -->
                                <a class="nav-link @Active("Dashboard")"
                                   asp-area="Admin"
                                   asp-controller="Dashboard"
                                   asp-action="Index">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-chart-pie"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Dashboard</span>
                                    </div>
                                </a>

                                <!-- Movies -->
                                <a class="nav-link @Active("Movies")"
                                   asp-area="Admin"
                                   asp-controller="Movies"
                                   asp-action="Index">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-film"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Movies</span>
                                    </div>
                                </a>

                                <!-- Add Movie -->
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Movies"
                                   asp-action="Create">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-plus"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Add Movie</span>
                                    </div>
                                </a>

                                <!-- Categories -->
                                <a class="nav-link @Active("Categories")"
                                   asp-area="Admin"
                                   asp-controller="Categories"
                                   asp-action="Index">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-list"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Categories</span>
                                    </div>
                                </a>

                                <!-- Cinemas -->
                                <a class="nav-link @Active("Cinemas")"
                                   asp-area="Admin"
                                   asp-controller="Cinemas"
                                   asp-action="Index">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-building"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Cinemas</span>
                                    </div>
                                </a>

                                <!-- Actors -->
                                <a class="nav-link @Active("Actors")"
                                   asp-area="Admin"
                                   asp-controller="Actors"
                                   asp-action="Index">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-users"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Actors</span>
                                    </div>
                                </a>

                                <!-- Bookings -->
                                <a class="nav-link"
                                   asp-area="Admin"
                                   asp-controller="Bookings"
                                   asp-action="Index">
                                    <div class="d-flex align-items-center">
                                        <span class="nav-link-icon">
                                            <span class="fas fa-ticket-alt"></span>
                                        </span>
                                        <span class="nav-link-text ps-1">Bookings</span>
                                    </div>
                                </a>

                            </li>
                        </ul>

                    </div>
                </div>
            </nav>

            <!-- Content -->
            <div class="content">

                <!-- Top Navbar -->
                <nav class="navbar navbar-light navbar-glass navbar-top navbar-expand">

                    <button class="btn navbar-toggler-humburger-icon navbar-toggler me-1 me-sm-3"
                            type="button"
                            data-bs-toggle="collapse"
                            data-bs-target="#navbarVerticalCollapse"
                            aria-controls="navbarVerticalCollapse"
                            aria-expanded="false"
                            aria-label="Toggle Navigation">
                        <span class="navbar-toggle-icon">
                            <span class="toggle-line"></span>
                        </span>
                    </button>

                    <a class="navbar-brand me-1 me-sm-3"
                       asp-area="Admin"
                       asp-controller="Dashboard"
                       asp-action="Index">
                        <div class="d-flex align-items-center">
                            <img class="me-2" src="~/images/cinema-logo.svg" alt="" width="40" />
                            <span class="font-sans-serif">Cinema</span>
                        </div>
                    </a>

                    <ul class="navbar-nav align-items-center d-none d-lg-block">
                        <li class="nav-item">
                            <div class="search-box">
                                <form class="position-relative" onsubmit="return false;">
                                    <input id="globalSearch"
                                           class="form-control search-input"
                                           type="search"
                                           placeholder="Search..."
                                           aria-label="Search" />
                                    <span class="fas fa-search search-box-icon"></span>
                                </form>
                            </div>
                        </li>
                    </ul>

                    <ul class="navbar-nav navbar-nav-icons ms-auto flex-row align-items-center">

                        <!-- Dark mode -->
                        <li class="nav-item">
                            <div class="theme-control-toggle fa-icon-wait px-2">
                                <input class="form-check-input ms-0 theme-control-toggle-input"
                                       id="themeControlToggle"
                                       type="checkbox"
                                       data-theme-control="theme"
                                       value="dark" />

                                <label class="mb-0 theme-control-toggle-label theme-control-toggle-light"
                                       for="themeControlToggle"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="left"
                                       title="Switch to light theme">
                                    <span class="fas fa-sun fs-0"></span>
                                </label>

                                <label class="mb-0 theme-control-toggle-label theme-control-toggle-dark"
                                       for="themeControlToggle"
                                       data-bs-toggle="tooltip"
                                       data-bs-placement="left"
                                       title="Switch to dark theme">
                                    <span class="fas fa-moon fs-0"></span>
                                </label>
                            </div>
                        </li>

                        <!-- Cart -->
                        <li class="nav-item d-none d-sm-block">
                            <a class="nav-link px-0 notification-indicator notification-indicator-warning notification-indicator-fill fa-icon-wait"
                               asp-area="Admin"
                               asp-controller="Bookings"
                               asp-action="Index">
                                <span class="fas fa-shopping-cart"
                                      data-fa-transform="shrink-7"
                                      style="font-size: 33px;"></span>
                                <span class="notification-indicator-number">1</span>
                            </a>
                        </li>

                        <!-- Bell -->
                        <li class="nav-item dropdown">
                            <a class="nav-link notification-indicator notification-indicator-primary px-0 fa-icon-wait"
                               href="#"
                               role="button">
                                <span class="fas fa-bell"
                                      data-fa-transform="shrink-6"
                                      style="font-size: 33px;"></span>
                            </a>
                        </li>

                        <!-- Apps grid -->
                        <li class="nav-item dropdown">
                            <a class="nav-link px-0"
                               href="#"
                               id="navbarDropdownMenu"
                               role="button"
                               data-bs-toggle="dropdown"
                               aria-haspopup="true"
                               aria-expanded="false">
                                <span class="fas fa-th"
                                      data-fa-transform="shrink-4"
                                      style="font-size: 33px;"></span>
                            </a>

                            <div class="dropdown-menu dropdown-menu-end dropdown-caret dropdown-caret-bg dropdown-menu-card"
                                 aria-labelledby="navbarDropdownMenu">

                                <div class="card shadow-none">
                                    <div class="card-body px-3 py-3">
                                        <div class="row text-center g-3">

                                            <div class="col-4">
                                                <a class="d-block text-decoration-none"
                                                   asp-area="Admin"
                                                   asp-controller="Movies"
                                                   asp-action="Index">
                                                    <span class="fas fa-film fs-2"></span>
                                                    <p class="mb-0 fs--2">Movies</p>
                                                </a>
                                            </div>

                                            <div class="col-4">
                                                <a class="d-block text-decoration-none"
                                                   asp-area="Admin"
                                                   asp-controller="Categories"
                                                   asp-action="Index">
                                                    <span class="fas fa-list fs-2"></span>
                                                    <p class="mb-0 fs--2">Categories</p>
                                                </a>
                                            </div>

                                            <div class="col-4">
                                                <a class="d-block text-decoration-none"
                                                   asp-area="Admin"
                                                   asp-controller="Cinemas"
                                                   asp-action="Index">
                                                    <span class="fas fa-building fs-2"></span>
                                                    <p class="mb-0 fs--2">Cinemas</p>
                                                </a>
                                            </div>

                                            <div class="col-4">
                                                <a class="d-block text-decoration-none"
                                                   asp-area="Admin"
                                                   asp-controller="Actors"
                                                   asp-action="Index">
                                                    <span class="fas fa-users fs-2"></span>
                                                    <p class="mb-0 fs--2">Actors</p>
                                                </a>
                                            </div>

                                            <div class="col-4">
                                                <a class="d-block text-decoration-none"
                                                   asp-area="Admin"
                                                   asp-controller="Bookings"
                                                   asp-action="Index">
                                                    <span class="fas fa-ticket-alt fs-2"></span>
                                                    <p class="mb-0 fs--2">Bookings</p>
                                                </a>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            </div>
                        </li>

                        <!-- Avatar -->
                        <li class="nav-item">
                            <a class="nav-link pe-0 ps-2" href="#" role="button">
                                <div class="avatar avatar-xl">
                                    <img class="rounded-circle"
                                         src="~/falcon/assets/img/team/3-thumb.png"
                                         alt="" />
                                </div>
                            </a>
                        </li>

                    </ul>
                </nav>

                @RenderBody()

                <!-- Footer -->
                <footer class="footer">
                    <div class="row g-0 justify-content-between fs--1 mt-4 mb-3">
                        <div class="col-12 col-sm-auto text-center">
                            <p class="mb-0 text-600">Cinema Admin &copy; 2026</p>
                        </div>
                    </div>
                </footer>

            </div>
        </div>
    </main>

    <script src="~/falcon/vendors/popper/popper.min.js"></script>
    <script src="~/falcon/vendors/bootstrap/bootstrap.min.js"></script>
    <script src="~/falcon/vendors/anchorjs/anchor.min.js"></script>
    <script src="~/falcon/vendors/is/is.min.js"></script>
    <script src="~/falcon/vendors/fontawesome/all.min.js"></script>
    <script src="~/falcon/vendors/lodash/lodash.min.js"></script>
    <script src="~/falcon/vendors/list.js/list.min.js"></script>
    <script src="~/falcon/assets/js/theme.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
