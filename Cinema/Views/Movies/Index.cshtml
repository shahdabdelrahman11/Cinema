
@model List<global::Cinema.Models.Movie>

@{
    ViewData["Title"] = "Movies";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalMovies = ViewBag.TotalMovies ?? 0;
    string searchString = ViewBag.SearchString ?? "";
}

<div class="container py-4">

   
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>Movies</h1>

        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-plus-lg"></i> Add New Movie
        </a>
    </div>


    <form asp-action="Index" method="get" class="mb-4">
        <div class="input-group">
            <input type="text"
                   name="searchString"
                   value="@searchString"
                   class="form-control"
                   placeholder="Search by movie name..."
                   aria-label="Search by movie name" />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Clear
            </a>
        </div>
    </form>


    <p class="text-muted mb-3">
        Total movies found: @totalMovies
    </p>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        <!-- Main Image -->
                        @if (!string.IsNullOrWhiteSpace(item.MainImg))
                        {
                            <img src="@Url.Content("~/images/" + item.MainImg)"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="width: 100%; height: 450px; object-fit: contain;"
                                 onerror="this.style.display='none'" />
                        }

                        <div class="card-body">

                            <!-- Movie Name -->
                            <h5 class="card-title">@item.Name</h5>

                            <!-- Description -->
                            <p class="card-text">@item.Des</p>

                            <!-- Price -->
                            <p>
                                <strong>Price:</strong>
                                @item.Price
                            </p>

                            <!-- Date -->
                            <p>
                                <strong>Date:</strong>
                                @item.DateTime.ToString("yyyy-MM-dd")
                            </p>

                            <!-- Status -->
                            <p>
                                <strong>Status:</strong>
                                @(item.Status ? "Available" : "Not Available")
                            </p>

                            <!-- Actors -->
                            <div class="mb-3">
                                <strong>Actors:</strong>

                                @if (item.Actors != null && item.Actors.Any())
                                {
                                    <div class="mt-1">
                                        @string.Join(", ",
                                            item.Actors
                                                .Select(a => $"{a.FirstName} {a.LastName}"))
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted mt-1">
                                        No actors assigned
                                    </div>
                                }
                            </div>

                            <!-- Additional Images -->
                            @if (item.SubImages != null && item.SubImages.Any())
                            {
                                <hr />

                                <p><strong>Additional Images:</strong></p>

                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var sub in item.SubImages)
                                    {
                                        <img src="@Url.Content("~/images/" + sub.Img)"
                                             alt="Additional image for @item.Name"
                                             style="height: 60px; width: 60px; object-fit: cover;"
                                             class="rounded border"
                                             onerror="this.style.display='none'" />
                                    }
                                </div>
                            }

                        </div>

                        <!-- Actions -->
                        <div class="card-footer bg-transparent border-top-0 pb-3">
                            <div class="d-flex gap-2 flex-wrap">

                                <!-- Book Now -->
                                @if (item.Status)
                                {
                                    <a asp-controller="Bookings"
                                       asp-action="Book"
                                       asp-route-id="@item.Id"
                                       class="btn btn-success btn-sm flex-fill">
                                        Book Now
                                    </a>
                                }
                                else
                                {
                                    <button type="button"
                                            class="btn btn-secondary btn-sm flex-fill"
                                            disabled>
                                        Not Available
                                    </button>
                                }

                                <!-- Edit -->
                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm flex-fill">
                                    Edit
                                </a>

                                <!-- Delete -->
                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      class="delete-form flex-fill">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm w-100">
                                        Delete
                                    </button>
                                </form>

                            </div>
                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    No movies found.
                </div>
            </div>
        }
    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Movies pagination">
            <ul class="pagination justify-content-center flex-wrap">

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchString="@searchString"
                       asp-route-page="@(currentPage - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-action="Index"
                           asp-route-searchString="@searchString"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-action="Index"
                       asp-route-searchString="@searchString"
                       asp-route-page="@(currentPage + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }
</div>

<!-- SweetAlert2 -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });
</script>
