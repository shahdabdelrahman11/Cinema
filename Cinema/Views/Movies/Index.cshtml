@model List<global::Cinema.Models.Movie>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Movies</h1>
    <a asp-action="Create" class="btn btn-success">Add New Movie</a>
</div>

<div class="row">
    @foreach (var item in Model)
    {
        <div class="col-md-4 mb-4">
            <div class="card h-100">
                <img src="~/images/@item.MainImg" class="card-img-top" alt="@item.Name" />

                <div class="card-body">
                    <h5 class="card-title">@item.Name</h5>
                    <p class="card-text">@item.Des</p>
                    <p><strong>Price:</strong> @item.Price</p>
                    <p><strong>Date:</strong> @item.DateTime.ToString("yyyy-MM-dd")</p>

                    @if (item.SubImages.Any())
                    {
                        <div class="d-flex flex-wrap gap-2">
                            @foreach (var sub in item.SubImages)
                            {
                                <img src="~/images/@sub.Img" style="height:60px" class="rounded"
                                     onerror="this.style.display='none'" />
                            }
                        </div>
                    }
                </div>

                <div class="card-footer bg-transparent border-top-0 pb-3 d-flex gap-2">
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-warning btn-sm">Edit</a>

                    <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="delete-form">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger btn-sm">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    }
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    document.querySelectorAll('.delete-form').forEach(form => {
        form.addEventListener('submit', function (e) {
            e.preventDefault();

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!",
                cancelButtonText: "Cancel"
            }).then((result) => {
                if (result.isConfirmed) {
                    form.submit();
                }
            });
        });
    });
</script>