
@model IEnumerable<global::Cinema.Models.Actor>

@{
    ViewData["Title"] = "Actors";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Actors Management</h2>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add New Actor
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Image</th>
                            <th>Full Name</th>
                            <th>Bio</th>
                            <th style="width:180px;">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.Any())
                        {
                            @foreach (var actor in Model)
                            {
                                <tr>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(actor.Img))
                                        {
                                            <img src="@actor.Img"
                                                 alt="@actor.FirstName"
                                                 style="width:65px;height:65px;object-fit:cover;border-radius:50%;" />
                                        }
                                        else
                                        {
                                            <span class="text-muted">No image</span>
                                        }
                                    </td>

                                    <td>
                                        @actor.FirstName @actor.LastName
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(actor.Bio)
                                            ? "No bio available"
                                            : actor.Bio.Length > 60
                                                ? actor.Bio.Substring(0, 60) + "..."
                                                : actor.Bio)
                                    </td>

                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@actor.Id"
                                           class="btn btn-warning btn-sm">
                                            Edit
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@actor.Id"
                                           class="btn btn-danger btn-sm">
                                            Delete
                                        </a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center py-4">
                                    No actors found.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
