
@model global::Cinema.Models.Cinema

@{
    ViewData["Title"] = "Edit Cinema";
}

<div class="container mt-5">
    <div class="card shadow-sm mx-auto" style="max-width:650px;">
        <div class="card-header bg-dark text-white">
            <h4 class="mb-0">Edit Cinema</h4>
        </div>

        <div class="card-body">
            <form asp-action="Edit"
                  asp-route-id="@Model.Id"
                  method="post"
                  enctype="multipart/form-data">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="Name" class="form-label">
                        Cinema Name
                    </label>
                    <input asp-for="Name"
                           class="form-control"
                           placeholder="Enter cinema name" />
                    <span asp-validation-for="Name"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label">
                        Description
                    </label>
                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Enter cinema description"></textarea>
                    <span asp-validation-for="Description"
                          class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Address" class="form-label">
                        Address
                    </label>
                    <input asp-for="Address"
                           class="form-control"
                           placeholder="Enter cinema address" />
                    <span asp-validation-for="Address"
                          class="text-danger"></span>
                </div>

                @if (!string.IsNullOrWhiteSpace(Model.Logo))
                {
                    <div class="mb-3">
                        <label class="form-label">Current Logo</label>
                        <div>
                            <img src="@Model.Logo"
                                 alt="Current cinema logo"
                                 style="width:140px;height:100px;object-fit:contain;border:1px solid #ddd;padding:5px;border-radius:8px;" />
                        </div>
                    </div>
                }

                <div class="mb-3">
                    <label class="form-label">Change Cinema Logo</label>

                    <input type="file"
                           id="LogoFile"
                           name="LogoFile"
                           class="form-control"
                           accept=".jpg,.jpeg,.png,.webp"
                           onchange="previewLogo(event)" />

                    <span class="text-danger">
                        @Html.ValidationMessage("LogoFile")
                    </span>

                    <small class="text-muted d-block mt-1">
                        Select a new image only if you want to replace
                        the current logo. JPG, PNG, WEBP — maximum 5 MB.
                    </small>

                    <div class="mt-3" id="previewContainer"
                         style="display:none;">
                        <p class="mb-2">New Logo Preview:</p>
                        <img id="logoPreview"
                             src=""
                             alt="New cinema logo preview"
                             style="width:140px;height:100px;object-fit:contain;border:1px solid #ddd;padding:5px;border-radius:8px;" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-warning">
                        <i class="fas fa-save"></i> Save Changes
                    </button>

                    <a asp-action="Index" class="btn btn-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        let currentPreviewUrl = null;

        function previewLogo(event) {
            const file = event.target.files[0];
            const preview = document.getElementById("logoPreview");
            const container = document.getElementById("previewContainer");

            if (currentPreviewUrl) {
                URL.revokeObjectURL(currentPreviewUrl);
                currentPreviewUrl = null;
            }

            if (!file) {
                preview.src = "";
                container.style.display = "none";
                return;
            }

            const allowedTypes = [
                "image/jpeg",
                "image/png",
                "image/webp"
            ];

            if (!allowedTypes.includes(file.type) ||
                file.size > 5 * 1024 * 1024) {
                alert("Choose a JPG, PNG, or WEBP image up to 5 MB.");
                event.target.value = "";
                preview.src = "";
                container.style.display = "none";
                return;
            }

            currentPreviewUrl = URL.createObjectURL(file);
            preview.src = currentPreviewUrl;
            container.style.display = "block";
        }
    </script>
}
