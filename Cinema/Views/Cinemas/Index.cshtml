
@model IEnumerable<global::Cinema.Models.Cinema>

@{
    ViewData["Title"] = "Cinemas Management";
}

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Cinemas Management</h2>
            <p class="text-muted">Manage cinema information.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Cinema
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">
            @if (Model.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Name</th>
                                <th>Description</th>
                                <th>Address</th>
                                <th>Logo</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cinema in Model)
                            {
                                <tr>
                                    <td>@cinema.Id</td>
                                    <td>@cinema.Name</td>
                                    <td>@(cinema.Description ?? "-")</td>
                                    <td>@(cinema.Address ?? "-")</td>
                                    <td>
                                        @if (!string.IsNullOrWhiteSpace(cinema.Logo))
                                        {
                                            <img src="@cinema.Logo"
                                                 alt="Cinema logo"
                                                 style="width:60px;height:45px;object-fit:contain;" />
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-action="Edit"
                                           asp-route-id="@cinema.Id"
                                           class="btn btn-warning btn-sm">Edit</a>

                                        <a asp-action="Delete"
                                           asp-route-id="@cinema.Id"
                                           class="btn btn-danger btn-sm">Delete</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="alert alert-info mb-0">
                    No cinemas found. Add your first cinema.
                </div>
            }
        </div>
    </div>

    <a href="/Dashboard" class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>
</div>
