
@model List<global::Cinema.Models.Movie>

@{
    ViewData["Title"] = "Movies";

    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 0;
    int totalMovies = ViewBag.TotalMovies ?? 0;
    string searchString = ViewBag.SearchString ?? "";
}

<div class="container py-4">

    <div class="mb-4">
        <h1>Discover Movies</h1>
        <p class="text-muted">Explore our available movies and book your tickets.</p>
    </div>

    <!-- Search -->
    <form asp-area="Customer"
          asp-controller="Movies"
          asp-action="Index"
          method="get"
          class="mb-4">

        <div class="input-group">
            <input type="text"
                   name="searchString"
                   value="@searchString"
                   class="form-control"
                   placeholder="Search by movie name..." />

            <button type="submit" class="btn btn-primary">
                Search
            </button>

            <a asp-area="Customer"
               asp-controller="Movies"
               asp-action="Index"
               class="btn btn-secondary">
                Clear
            </a>
        </div>
    </form>

    <p class="text-muted mb-3">
        Total movies found: @totalMovies
    </p>

    <!-- Movies Cards -->
    <div class="row">

        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-4 mb-4">
                    <div class="card h-100 shadow-sm">

                        <!-- Main Image -->
                        @if (!string.IsNullOrWhiteSpace(item.MainImg))
                        {
                            <img src="@Url.Content("~/images/" + item.MainImg)"
                                 class="card-img-top"
                                 alt="@item.Name"
                                 style="width:100%; height:450px; object-fit:contain;"
                                 onerror="this.style.display='none'" />
                        }

                        <div class="card-body">

                            <h5 class="card-title">@item.Name</h5>

                            <p class="card-text">@item.Des</p>

                            <p>
                                <strong>Price:</strong>
                                @item.Price
                            </p>

                            <p>
                                <strong>Date:</strong>
                                @item.DateTime.ToString("yyyy-MM-dd")
                            </p>

                            <p>
                                <strong>Status:</strong>

                                @if (item.Status)
                                {
                                    <span class="badge bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Not Available</span>
                                }
                            </p>

                            <!-- Actors -->
                            <div class="mb-3">
                                <strong>Actors:</strong>

                                @if (item.Actors != null && item.Actors.Any())
                                {
                                    <div class="mt-1">
                                        @string.Join(", ",
                                            item.Actors.Select(a =>
                                                $"{a.FirstName} {a.LastName}"))
                                    </div>
                                }
                                else
                                {
                                    <div class="text-muted">
                                        No actors assigned
                                    </div>
                                }
                            </div>

                            <!-- Additional Images -->
                            @if (item.SubImages != null && item.SubImages.Any())
                            {
                                <hr />

                                <p><strong>Additional Images:</strong></p>

                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var sub in item.SubImages)
                                    {
                                        <img src="@Url.Content("~/images/" + sub.Img)"
                                             alt="Additional image"
                                             style="height:60px;width:60px;object-fit:cover;"
                                             class="rounded border"
                                             onerror="this.style.display='none'" />
                                    }
                                </div>
                            }

                        </div>

                        <!-- Booking Button -->
                        <div class="card-footer bg-transparent pb-3">

                            @if (item.Status)
                            {
                                <a asp-area="Customer"
                                   asp-controller="Bookings"
                                   asp-action="Book"
                                   asp-route-id="@item.Id"
                                   class="btn btn-success w-100">
                                    Book Now
                                </a>
                            }
                            else
                            {
                                <button type="button"
                                        class="btn btn-secondary w-100"
                                        disabled>
                                    Not Available
                                </button>
                            }

                        </div>

                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12">
                <div class="alert alert-warning text-center">
                    No movies found.
                </div>
            </div>
        }

    </div>

    <!-- Pagination -->
    @if (totalPages > 1)
    {
        <nav aria-label="Movies pagination">
            <ul class="pagination justify-content-center flex-wrap">

                <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                    <a class="page-link"
                       asp-area="Customer"
                       asp-controller="Movies"
                       asp-action="Index"
                       asp-route-searchString="@searchString"
                       asp-route-page="@(currentPage - 1)">
                        Previous
                    </a>
                </li>

                @for (int i = 1; i <= totalPages; i++)
                {
                    <li class="page-item @(i == currentPage ? "active" : "")">
                        <a class="page-link"
                           asp-area="Customer"
                           asp-controller="Movies"
                           asp-action="Index"
                           asp-route-searchString="@searchString"
                           asp-route-page="@i">
                            @i
                        </a>
                    </li>
                }

                <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                    <a class="page-link"
                       asp-area="Customer"
                       asp-controller="Movies"
                       asp-action="Index"
                       asp-route-searchString="@searchString"
                       asp-route-page="@(currentPage + 1)">
                        Next
                    </a>
                </li>

            </ul>
        </nav>
    }

</div>

