
@model global::Cinema.ViewModels.DashboardVM
@using System.Text.Json

@{
    ViewData["Title"] = "Dashboard";
}

<style>
    .stat-card {
        transition: transform .2s ease;
    }

    .stat-card:hover {
        transform: translateY(-3px);
    }

    .stat-card .card-footer a {
        color: #fff;
        text-decoration: none;
    }

    .stat-card h6, .stat-card h2, .stat-card small, .stat-card div {
        color: #fff;
    }

    .table th, .table td {
        vertical-align: middle;
        white-space: nowrap;
    }
</style>

<h3 class="mb-1">Dashboard</h3>
<p class="text-muted">Cinema Management Overview</p>

<div class="row g-3 mb-4">

    <!-- Movies -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white bg-primary h-100">
            <div class="card-body">
                <i class="fas fa-film fa-2x mb-2"></i>
                <div>Movies</div>
                <h2>@Model.MoviesCount</h2>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Admin" asp-controller="Movies" asp-action="Index">View Details</a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

    <!-- Categories -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white bg-warning h-100">
            <div class="card-body">
                <i class="fas fa-list fa-2x mb-2"></i>
                <div>Categories</div>
                <h2>@Model.CategoriesCount</h2>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Admin" asp-controller="Categories" asp-action="Index">Manage Categories</a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

    <!-- Available Movies -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white bg-success h-100">
            <div class="card-body">
                <i class="fas fa-check-circle fa-2x mb-2"></i>
                <div>Available Movies</div>
                <h2>@Model.AvailableMovies</h2>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Admin" asp-controller="Movies" asp-action="Index">View Details</a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

    <!-- Cinemas -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white bg-danger h-100">
            <div class="card-body">
                <i class="fas fa-building fa-2x mb-2"></i>
                <div>Cinemas</div>
                <h2>@Model.CinemasCount</h2>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Admin" asp-controller="Cinemas" asp-action="Index">Manage Cinemas</a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

    <!-- Total Bookings -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white bg-info h-100">
            <div class="card-body">
                <i class="fas fa-ticket-alt fa-2x mb-2"></i>
                <div>Total Bookings</div>
                <h2>@Model.BookingsCount</h2>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Customer"
                   asp-controller="Bookings"
                   asp-action="Index">
                    View All Bookings
                </a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

    <!-- Total Booking Value -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white bg-secondary h-100">
            <div class="card-body">
                <i class="fas fa-money-bill-wave fa-2x mb-2"></i>
                <div>Total Booking Value</div>
                <h2>@Model.TotalBookingValue.ToString("N2")</h2>
                <small>Based on ticket quantities and current movie prices.</small>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Customer"
                   asp-controller="Bookings"
                   asp-action="Index">
                    View Bookings
                </a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

    <!-- Actors -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card text-white h-100" style="background-color:#6f42c1;">
            <div class="card-body">
                <i class="fas fa-users fa-2x mb-2"></i>
                <div>Actors</div>
                <h2><i class="fas fa-user-check"></i></h2>
                <small>Manage actors and their images.</small>
            </div>
            <div class="card-footer d-flex justify-content-between">
                <a asp-area="Admin" asp-controller="Actors" asp-action="Index">Manage Actors</a>
                <i class="fas fa-angle-right"></i>
            </div>
        </div>
    </div>

</div>

<!-- Charts -->
<div class="row g-3 mb-4">

    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fas fa-chart-area me-1"></i> Movies per Month
            </div>
            <div class="card-body">
                <canvas id="areaChart" height="130"></canvas>
            </div>
        </div>
    </div>

    <div class="col-xl-6">
        <div class="card h-100">
            <div class="card-header">
                <i class="fas fa-chart-bar me-1"></i> Movies per Category
            </div>
            <div class="card-body">
                <canvas id="barChart" height="130"></canvas>
            </div>
        </div>
    </div>

</div>

<!-- Latest Movies -->
<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-film me-1"></i> Latest Movies</span>

        <input id="tableSearch"
               class="form-control form-control-sm w-auto"
               placeholder="Search movies..." />
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0" id="moviesTable">

            <thead>
                <tr>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Cinema</th>
                    <th>Date</th>
                    <th>Price</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.LatestMovies.Any())
                {
                    foreach (var m in Model.LatestMovies)
                    {
                        <tr>
                            <td>@m.Name</td>
                            <td>@m.Category?.Name</td>
                            <td>@m.Cinema?.Name</td>
                            <td>@m.DateTime.ToString("yyyy/MM/dd")</td>
                            <td>@m.Price.ToString("N2")</td>

                            <td>
                                @if (m.Status)
                                {
                                    <span class="badge text-bg-success">Available</span>
                                }
                                else
                                {
                                    <span class="badge text-bg-danger">Not Available</span>
                                }
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            No movies found.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

<!-- Latest Bookings -->
<div class="card mb-4">

    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="fas fa-ticket-alt me-1"></i> Latest Bookings</span>

        <a asp-area="Customer"
           asp-controller="Bookings"
           asp-action="Index"
           class="btn btn-primary btn-sm">
            View All Bookings
        </a>
    </div>

    <div class="table-responsive">
        <table class="table table-hover mb-0">

            <thead>
                <tr>
                    <th>Booking ID</th>
                    <th>Customer Name</th>
                    <th>Movie</th>
                    <th>Tickets</th>
                    <th>Show Date &amp; Time</th>
                    <th>Total Price</th>
                    <th>Payment Method</th>
                </tr>
            </thead>

            <tbody>
                @if (Model.LatestBookings.Any())
                {
                    foreach (var booking in Model.LatestBookings)
                    {
                        <tr>
                            <td>@booking.Id</td>
                            <td>@booking.CustomerName</td>
                            <td>@(booking.Movie?.Name ?? "Unknown")</td>
                            <td>@booking.NumberOfTickets</td>
                            <td>@booking.ShowDateTime.ToString("yyyy/MM/dd HH:mm")</td>

                            <td>
                                @if (booking.Movie != null)
                                {
                                    @((booking.Movie.Price * booking.NumberOfTickets).ToString("N2"))
                                }
                                else
                                {
                                    <text>N/A</text>
                                }
                            </td>

                            <td>@booking.PaymentMethod</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center text-muted py-4">
                            <i class="fas fa-ticket-alt fa-2x mb-2 d-block"></i>
                            No bookings found yet.
                        </td>
                    </tr>
                }
            </tbody>

        </table>
    </div>
</div>

@section Scripts {

    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>

    <script>
        const monthLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthLabels));
        const monthCounts = @Html.Raw(JsonSerializer.Serialize(Model.MonthCounts));

        const catLabels = @Html.Raw(JsonSerializer.Serialize(Model.CategoryLabels));
        const catCounts = @Html.Raw(JsonSerializer.Serialize(Model.CategoryCounts));

        // Movies per Month Chart
        new Chart(document.getElementById('areaChart'), {
            type: 'line',

            data: {
                labels: monthLabels,

                datasets: [{
                    label: 'Movies',
                    data: monthCounts,
                    fill: true,
                    tension: 0.4,
                    borderColor: '#2c7be5',
                    backgroundColor: 'rgba(44,123,229,0.2)',
                    pointBackgroundColor: '#2c7be5'
                }]
            },

            options: {
                responsive: true,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

        // Movies per Category Chart
        new Chart(document.getElementById('barChart'), {
            type: 'bar',

            data: {
                labels: catLabels,

                datasets: [{
                    label: 'Movies',
                    data: catCounts,
                    backgroundColor: '#2c7be5'
                }]
            },

            options: {
                responsive: true,

                plugins: {
                    legend: {
                        display: false
                    }
                },

                scales: {
                    y: {
                        beginAtZero: true,
                        ticks: {
                            precision: 0
                        }
                    }
                }
            }
        });

        // Search in Latest Movies Table
        document.getElementById('tableSearch').addEventListener('input', function (e) {

            const value = e.target.value.toLowerCase();

            document.querySelectorAll('#moviesTable tbody tr').forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value) ? '' : 'none';

            });

        });
    </script>
}
